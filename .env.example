# Copy to .env and adjust. Every value is optional; the app runs with the defaults.

# --- Flask ---------------------------------------------------------------
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
PORT=5000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# --- Database ------------------------------------------------------------
# Default: SQLite file in ./instance/krishidisha.db (zero setup).
# MySQL example (needs mysql-connector-python, already in requirements):
# DATABASE_URL=mysql+mysqlconnector://root:password@localhost/farmer_details
# DATABASE_URL=

# --- Auth ----------------------------------------------------------------
# New farmers must be verified by an admin (as in the project report).
# Set to true for demos so registrations can log in immediately.
AUTO_VERIFY_FARMERS=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Assistant (LLM) -----------------------------------------------------
# LLM_PROVIDER: auto | anthropic | openai | rules
#   auto      -> anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY
#                or OPENAI_BASE_URL is set, else the offline rules bot.
#   rules     -> offline assistant (still runs the ML models, weather, prices, KB search).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, or a local Ollama / LM Studio.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Local example (Ollama): OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1
LLM_MAX_TOOL_ROUNDS=6
CHAT_HISTORY_TURNS=12
# Regional languages for the local model / rules bot: none | indictrans2 (local ai4bharat models,
# pip install IndicTransToolkit) | bhashini (hosted; set BHASHINI_USER_ID and BHASHINI_API_KEY).
# The Anthropic provider handles Indian languages itself.
TRANSLATION_BACKEND=none
# Dense multilingual retrieval over the knowledge base (pip install sentence-transformers). Empty = TF-IDF only.
# KB_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Teacher model for LLM training data (ml/llm/distill.py) -------------
# Free option: Google AI Studio key -> Gemini 2.5 Flash through its OpenAI-compatible endpoint (rate-limited,
# runs for days in the background). Paid option: Anthropic Message Batches (ANTHROPIC_API_KEY above).
# GEMINI_API_KEY=
# TEACHER_PROVIDER=gemini          # anthropic | gemini | openai | groq | openrouter | ollama
# GROQ_API_KEY=                   # TEACHER_PROVIDER=groq  (free tier: llama-3.3-70b ~1,000 req/day, no card needed)
# OPENROUTER_API_KEY=             # TEACHER_PROVIDER=openrouter (free models: 50 req/day, 1,000/day once $10 credit is on the account)
# TEACHER_BASE_URL=                # any other OpenAI-style endpoint (openai/ollama)
# TEACHER_API_KEY=
# TEACHER_RPM=8                    # requests per minute for sequential providers

# --- External data -------------------------------------------------------
# data.gov.in key for live Agmarknet mandi prices (public sample key is the default).
DATA_GOV_API_KEY=
WEATHER_CACHE_SECONDS=900

# --- Marketplace ---------------------------------------------------------
CURRENCY=INR
FREE_DELIVERY_ABOVE=999
DELIVERY_CHARGE=49
UPI_ID=krishidisha@upi

# --- Disease model -------------------------------------------------------
# DISEASE_MODEL_BACKEND: auto | local | hf | legacy | stub
#   local  -> models/plant_disease_model.pt trained with `python -m ml.train_disease`
#   hf     -> download DISEASE_HF_MODEL from the Hugging Face Hub (needs internet once)
#   legacy -> the original models/plant_disease_model_1_latest.pt from CNN.py
DISEASE_MODEL_BACKEND=auto
DISEASE_HF_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# --- Paths (rarely needed) ----------------------------------------------
# DATA_DIR=./data
# MODELS_DIR=./models
# UPLOAD_DIR=./static/uploads
